# Variable names only. Copy values into your shell or a git-ignored .env file.
# Never commit real values.

# Which agent configuration to load (mock config runs without any API calls)
SV_CONFIG=config/agent.mock.yaml

# Signing key for login cookies. If empty, a random key is generated at startup.
SV_SESSION_SECRET=

# Comma-separated emails that may open the operations dashboard
SV_ADMIN_EMAILS=

# Phase 7 only (paid API). Not used by the mock configuration.
ANTHROPIC_API_KEY=
